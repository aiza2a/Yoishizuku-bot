BOT_TOKEN=
API_KEY=
BASE_URL=https://api.openai.com/v1/chat/completions
MODEL=deepseek-v4-flash-free
ADMIN_LIST=
GROUP_LIST=

# 可选：初始用户白名单。留空表示不启用用户白名单。
# whitelist=
# BLACK_LIST=
# CHAT_MODE=multiusers
# 全局模式仅适用于单管理员机器人；必须同时设置 ADMIN_LIST。
# NICK=
# NICK_ALIASES=
# LANGUAGE=Simplified Chinese

# === Yoishizuku-bot 本地化配置 ===
PERSONA_FILE=persona.env
SYSTEMPROMPT_FILE=/home/persona/systemprompt.md
MEMORY_DB_PATH=/home/memory_data/gptbot_memory.sqlite3
MEMORY_RECENT_TURNS=8
MEMORY_MAX_CONTEXT_CHARS=7000
MEMORY_SUMMARY_EVERY=8
ROLE_DATA_ROOT=/home/role_data
ACCESS_CONTROL_FILE=/home/access_data/access_control.json

# Telegram Draft 临时预览默认关闭；设为 1 才在私聊启用。
# DRAFT_MODE=1

# Telegram Bot API 10.0 富文本模式：表格、标题、LaTex、嵌入媒体等。
# 默认关闭，保持 MarkdownV2 兼容输出。
# RICH_MESSAGE=1

# 详细引擎日志会记录完整请求体，其中包含 API 密钥与对话内容；仅排查问题时临时开启。
# VERBOSE_ENGINE_LOG=True

# === Tool policy ===
# 以下工具已从本项目移除，无法通过允许列表恢复：
# `download_read_arxiv_pdf`（论文）、`run_python_script`（代码执行）、
# `excute_command`（容器命令）、`list_directory`、`set_readonly_path`（容器文件系统）。
# 仅将这些工具暴露给模型和 Telegram 插件菜单；支持 * 通配符。
# 例如：TOOL_ALLOWLIST=get_search_results,get_url_content
# TOOL_ALLOWLIST=
# TOOL_DENYLIST=
# 工具开关与允许列表独立；例如：search_scoped=True
# 仅向支持 OpenAI tools/function calling 的模型发送 tools 字段；支持 * 通配符。
# 留空保持旧行为（所有模型均允许）。建议生产环境明确配置支持工具的模型。
# Grok 兼容网关需显式加入本列表，才会恢复被上游核心默认移除的 tools 字段。
# 例如：TOOL_CALL_MODELS=deepseek-v4-flash-free,gpt-4o,gpt-4.1,claude-*
# TOOL_CALL_MODELS=
# TOOL_DISABLED_MODELS=
# 个别网关的工具调用不支持 SSE 时，可让匹配模型仅在启用工具时使用非流式 HTTP 响应。
# 例如：TOOL_NONSTREAM_MODELS=grok-4.20-fast
# TOOL_NONSTREAM_MODELS=

# === Scoped multi-provider search ===
# 统一聚合 Tavily、Exa、Google 与 DuckDuckGo；未配置 API 密钥的来源会自动跳过，DDG 兜底。
# SEARCH_PROVIDERS=tavily,exa,google,ddg
# SEARCH_PROVIDER_TIMEOUT=8
# SEARCH_MAX_RESULTS=5
# Tavily: https://tavily.com/；Exa: https://exa.ai/；Google 需 Programmable Search 的 API Key 与搜索引擎 ID。
# TAVILY_API_KEY=
# EXA_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
